# ElevenLabs free tier works for testing. Free-tier output is non-commercial,
# requires attribution, and must be regenerated on a commercially licensed plan
# before commercial use. Use a voice you are permitted to use.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
VOICE_PROVIDER=kokoro

# Optional: Pixabay video search. Get a free API key at https://pixabay.com/api/docs/
# The studio saves the clip creator and source page alongside selected footage.
PIXABAY_API_KEY=

# Optional local Kokoro voice preset (default is the same American voice every time).
KOKORO_VOICE=af_heart

# AI provider: auto (Gemini first, then OpenAI), gemini, openai, or none.
AI_PROVIDER=auto
# Google AI Studio offers a free tier for selected Gemini models; quotas apply.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional OpenAI fallback. API usage is billed separately from ChatGPT.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
